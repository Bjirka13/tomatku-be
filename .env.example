APP_NAME=TomatKU API
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tomatku
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/tomatku # Set this to local db

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=detection_images
MAX_IMAGE_SIZE_BYTES=5000000

# Model
MODEL_PATH=artifact/best.pt
PIPELINE_PATH=artifact/external_pipeline.py

# Security / misc
SECRET_KEY=development-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
